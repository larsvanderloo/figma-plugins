{
  "name": "welder-editor",
  "version": "0.5.172",
  "type": "module",
  "scripts": {
    "build": "npm run build:aliases && npm run build:svgs && npm run build:ui && npm run build:widget",
    "build:aliases": "node generate-lucide-aliases.mjs",
    "build:svgs": "node generate-lucide-svgs.mjs",
    "build:ui": "vite build",
    "build:widget": "node esbuild.config.mjs",
    "watch": "npm run build:aliases && npm run build:svgs && concurrently --kill-others-on-fail \"vite build --watch\" \"node esbuild.config.mjs --watch\"",
    "dev:ui": "vite",
    "typecheck:ui": "vue-tsc --noEmit -p tsconfig.ui.json"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.100.0",
    "@iconify-json/lucide": "^1.2.102",
    "@nuxt/ui": "^4.6.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.4.0",
    "vite": "^8.0.9",
    "vite-plugin-singlefile": "^2.3.3",
    "vue": "^3.5.33",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.2.7"
  },
  "dependencies": {
    "cropperjs": "^1",
    "pdf-lib": "^1.17.1",
    "pinia": "^3.0.4",
    "vue-picture-cropper": "^1.0.0"
  }
}
