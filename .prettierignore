# Prettier ignore — mirrors .gitignore for files Prettier shouldn't touch.

# Build output
dist/
build/
.vite/
.cache/
.output/

# Per-plugin builds
plugins/*/dist/
components/dist/
sections/*/dist/
packages/*/dist/

# Dependencies
node_modules/
.pnpm-store/

# Lockfiles (pnpm format diverges from prettier)
pnpm-lock.yaml
package-lock.json
yarn.lock

# Python
.venv/
.venv-*/
__pycache__/

# Generated / large
*.tsbuildinfo
coverage/

# Generated by @nuxt/ui/vite (unplugin-auto-import + unplugin-vue-components)
# Regenerated on every build/vitest run; not human-authored.
#
# NOTE: Prettier 3.x resolves .prettierignore from the CWD, not by walking up
# the directory tree. Patterns below only apply when prettier is invoked from
# the repo root (e.g., `pnpm format:check`). Per-package `pnpm -r lint` runs
# are covered by per-package .prettierignore files in each workspace directory.
**/auto-imports.d.ts
**/components.d.ts
