# Build artifacts
# dist/ is intentionally tracked so a fresh clone loads in Figma without
# requiring `npm install && npm run build` — rebuild + commit alongside
# source changes to keep them in sync.
build/
out/
.cache/
.vite/
.nuxt/
.output/

# Node
node_modules/
.npm/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.vscode/*
!.vscode/
!.vscode/tasks.json
.idea/
*.code-workspace

# Claude Code ephemera
.claude/

# TypeScript / Vue
*.tsbuildinfo
.vue-tsc/

# Generated by @nuxt/ui/vite (unplugin-auto-import + unplugin-vue-components).
# Regenerated on every UI build; not human-authored.
plugin-src/ui/auto-imports.d.ts
plugin-src/ui/components.d.ts

# Test / coverage
coverage/
.nyc_output/
.vitest-cache/

# Local config (untracked)
.local/

# Secrets — never commit
*.pem
*.key
*.figma-token

# Figma plugin manifest debugging
manifest-cache/
