# Build artifacts
# dist/ is build output, not tracked. Figma loads it from the local working
# tree via manifest.json (main: dist/code.js, ui: dist/ui.html); a fresh
# clone runs `npm install && npm run build` once before importing the plugin.
dist/
build/
out/
.cache/
.vite/
.nuxt/
.output/

# Node
node_modules/
.npm/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.vscode/*
!.vscode/
!.vscode/tasks.json
.idea/
*.code-workspace

# Claude Code ephemera
.claude/

# TypeScript / Vue
*.tsbuildinfo
.vue-tsc/

# Nuxt UI must write generated templates under the root node_modules tree.
# A nested UI node_modules means Vite root drifted and release/debug guards
# should fail before Figma imports a confusing workspace.
src/ui/node_modules/

# Test / coverage
coverage/
.nyc_output/
.vitest-cache/

# Local config (untracked)
.local/

# Secrets — never commit
*.pem
*.key
*.figma-token

# Figma plugin manifest debugging
manifest-cache/
