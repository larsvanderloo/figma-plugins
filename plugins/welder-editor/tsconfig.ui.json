{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "preserve",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@/*": ["./plugin-src/ui/*"]
    }
  },
  "include": [
    "plugin-src/ui/**/*.ts",
    "plugin-src/ui/**/*.tsx",
    "plugin-src/ui/**/*.vue",
    "plugin-src/ui/shims-vue.d.ts",
    "plugin-src/types.ts",
    "plugin-src/constants.ts",
    "plugin-src/chart-core/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "vite.config.ts", "app.config.ts", "esbuild.config.mjs"]
}
