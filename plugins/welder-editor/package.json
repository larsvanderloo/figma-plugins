{
  "name": "@figma-plugins/welder-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Welder Editor — Figma plugin",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "dev:code": "vite build --config vite.code.config.ts --watch",
    "build": "vite build && vite build --config vite.code.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check ."
  },
  "dependencies": {
    "vue": "^3.4.0",
    "@nuxt/ui": "^4.6.1",
    "@iconify/vue": "^4.3.0",
    "@iconify-json/lucide": "^1.2.102",
    "tailwindcss": "^4.2.4",
    "cropperjs": "^1.6.2",
    "vue-picture-cropper": "^1.0.0",
    "@figma-plugins/components": "workspace:*",
    "@figma-plugins/figma-api": "workspace:*",
    "@figma-plugins/sections-slide-picker": "workspace:*",
    "@figma-plugins/sections-tab-strip": "workspace:*",
    "@figma-plugins/sections-property-panel": "workspace:*",
    "@figma-plugins/sections-title-description-editor": "workspace:*",
    "@figma-plugins/sections-badge-editor": "workspace:*",
    "@figma-plugins/sections-icon-picker": "workspace:*",
    "@figma-plugins/sections-image-editor": "workspace:*",
    "@figma-plugins/sections-card-list": "workspace:*",
    "@figma-plugins/sections-card-editor": "workspace:*",
    "@figma-plugins/sections-timeline-editor": "workspace:*",
    "@figma-plugins/sections-table-editor": "workspace:*",
    "@figma-plugins/sections-journey-editor": "workspace:*",
    "pinia": "^3",
    "pinia-plugin-persistedstate": "^4",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.100.0",
    "@testing-library/vue": "^8.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.5.1",
    "axe-core": "^4.10.0",
    "jsdom": "^24.0.0",
    "rollup-plugin-visualizer": "^5",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^1.5.0",
    "vue-tsc": "^2.0.0"
  }
}
