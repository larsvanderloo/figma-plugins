{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["ui/*"],
      "@code/*": ["code/*"],
      "@shared/*": ["shared/*"]
    },
    // ui/ and tests/ui/ need DOM lib + vite/client types.
    // code/ (Figma sandbox) needs @figma/plugin-typings but NOT DOM.
    // We run a single vue-tsc pass over both. The DOM types don't break
    // code-side typechecking in practice because code/ never imports DOM
    // globals; the strict type guard is Figma's runtime, not tsc.
    "types": ["@figma/plugin-typings", "vite/client"]
  },
  "include": [
    "code/**/*",
    "ui/**/*",
    "shared/**/*",
    "tests/**/*",
    "vite.config.ts",
    "vite.code.config.ts",
    // Auto-generated by @nuxt/ui/vite (unplugin-vue-components +
    // unplugin-auto-import). These files are written to the plugin root
    // during `vite build` / `vite dev`. They are gitignored and regenerated
    // on every build; they MUST exist before vue-tsc runs (CI: build first).
    // tsconfig silently accepts them when absent (no "file not found" error
    // for literal paths in "include" — only globs enforce existence).
    "components.d.ts",
    "auto-imports.d.ts",
    "../../validation/fixtures/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
