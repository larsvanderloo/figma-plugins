{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["ui/*"],
      "@code/*": ["code/*"],
      "@shared/*": ["shared/*"]
    },
    "types": ["@figma/plugin-typings", "vite/client"]
  },
  "include": ["code/**/*", "ui/**/*", "shared/**/*", "tests/**/*", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
